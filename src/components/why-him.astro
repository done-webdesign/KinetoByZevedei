    >
      <div class="relative cursor-pointer select-none" id="whyhim-wrapper" role="button" tabindex="0">
        <video
          id="whyhim-video"
          class="lg:w-[500px] lg:h-[500px] h-84 w-64 object-cover rounded-2xl shadow"
          muted
          autoplay
          loop
          playsinline
          preload="metadata"
        >
          <source src="/videos/video-3.mp4" type="video/mp4" />
        </video>
        <div id="whyhim-indicator" class="pointer-events-none absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-200">
          <!-- Icon injected by script based on state -->
        </div>
      </div>
    </div>
    <div class="background-7"></div>
    <div class="background-8"></div>
  </div>
</div>
