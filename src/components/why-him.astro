<script>
  document.addEventListener('DOMContentLoaded', () => {
    const wrapper = document.getElementById('whyhim-wrapper');
    const vid = document.getElementById('whyhim-video');
    const ind = document.getElementById('whyhim-indicator');
    if (!(wrapper instanceof HTMLElement) || !(vid instanceof HTMLVideoElement) || !(ind instanceof HTMLElement)) return;

    const renderIcon = () => {
      ind.innerHTML = vid.paused
        ? '<svg width="64" height="64" viewBox="0 0 24 24" fill="white" class="bg-black/40 rounded-full p-3"><path d="M8 5v14l11-7z"></path></svg>'
        : '<svg width="64" height="64" viewBox="0 0 24 24" fill="white" class="bg-black/40 rounded-full p-3"><rect x="6" y="5" width="4" height="14" rx="1"></rect><rect x="14" y="5" width="4" height="14" rx="1"></rect></svg>';
    };

    const flash = () => {
      renderIcon();
      ind.style.opacity = '1';
      window.setTimeout(() => (ind.style.opacity = '0'), 700);
    };

    const toggle = () => {
      if (vid.paused) vid.play().catch(() => {}); else vid.pause();
      flash();
    };

    wrapper.addEventListener('click', toggle);
    wrapper.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); toggle(); }
    });
  });
</script>
