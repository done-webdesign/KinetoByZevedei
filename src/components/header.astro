---
import Image from "astro/components/Image.astro";
import logo from "../assets/images/kineto-logo.webp";
import MobileDropdownMenu from "./nobile-header";
---

<script>
  document.addEventListener("DOMContentLoaded", () => {
    document.getElementById("scroll-despre")?.addEventListener("click", () => {
      document
        .getElementById("despre-zevedei")
        ?.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  });
</script>

<header class="lg:flex hidden sticky top-0 z-[1000] px-[10px] justify-between items-center h-[140px] bg-[var(--primary)] md:h-[100px]">
  <a href="/">
    <Image
      class="w-[626px] h-[88px] md:w-[400px] md:h-auto hover:!scale-100"
      src={logo}
      alt="Kinetoterapie by zevedei logo"
      widths={[300, 400, 626]}
      sizes="(max-width: 1124px) 400px, 626px"
    />
  </a>

  <div class="flex justify-between max-w-[600px] w-full items-center">
    <a href="/servicii" class="bg-transparent border-0 text-[var(--text)] text-[16px] font-normal leading-[100%] hover:!scale-100 md:text-[14px] md:font-light md:leading-[90%]">Serviciile noastre</a>
    <button id="scroll-despre" class="bg-transparent border-0 text-[var(--text)] text-[16px] font-normal leading-[100%] hover:!scale-100 md:text-[14px] md:font-light md:leading-[90%]">Despre Zevedei</button>
    <a
      href="/servicii#contact"
      class="flex justify-center items-center px-[30px] py-[18px] text-[var(--text)] text-[14px] font-extrabold leading-6 uppercase w-[200px] h-[50px] rounded-[24px] bg-[var(--assets)] transition-transform hover:scale-105"
      >Contacteaza-ne</a
    >
  </div>
</header>
<div class="lg:hidden">
  <MobileDropdownMenu client:idle />
</div>
<!-- Tailwind utility classes set on elements; inline styles removed -->
