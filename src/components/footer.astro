---
import Image from "astro/components/Image.astro";
import Logo from "../assets/images/logo-small.webp";
import LogoText from "../assets/images/logo-text-small.webp";
import InstaIcon from "../assets/images/insta-icon.svg";
import TiktokIcon from "../assets/images/tiktok-icon.svg";
---

<script>
  function attachScrollListener() {
    const button = document.getElementById("scroll-despre");
    const target = document.getElementById("despre-zevedei");

    if (button && target) {
      button.addEventListener("click", () => {
        target.scrollIntoView({ behavior: "smooth", block: "start" });
      });
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    attachScrollListener();

    // Optional: retry in case footer is hydrated later
    const observer = new MutationObserver(attachScrollListener);
    observer.observe(document.body, { childList: true, subtree: true });
  });
</script>

<footer class="grid grid-cols-2 bg-[var(--components)] h-[400px]">
  <div class="p-6 flex flex-col justify-center items-center gap-9 rounded-[0px_120px_120px_0px] bg-[var(--primary)]">
    <div class="flex justify-center items-center lg:h-14 h-7">
      <Image
        src={Logo}
        alt={"Kinetoterapie by zevedei logo"}
        class="h-full w-auto object-contain"
        widths={[120, 160, 200]}
        sizes="120px"
      />
      <Image
        src={LogoText}
        alt={"Kinetoterapie by zevedei text logo "}
        class="h-full w-auto object-contain"
        widths={[120, 160, 200]}
        sizes="120px"
      />
    </div>

    <div class="flex flex-col justify-center items-center gap-9">
      <a href="/servicii" class="text-center text-[34px] font-extralight leading-[34px] text-[var(--text)] md:text-[14px] md:leading-[14px] md:font-light">Serviciile noastre</a>
      <button id="scroll-despre" class="text-center text-[34px] font-extralight leading-[34px] text-[var(--text)] md:text-[14px] md:leading-[14px] md:font-light">Despre Zevedei</button>
      <a href="/servicii#contact" class="text-center text-[34px] font-extralight leading-[34px] text-[var(--assets)] md:text-[14px] md:leading-[14px] md:font-light">CONTACTEAZA-NE</a>
    </div>
  </div>
  <div class="flex justify-center items-center">
    <div class="flex flex-col gap-4 justify-center items-center">
      <a
        href="https://www.tiktok.com/@kineto.by.zevedei?is_from_webapp=1&sender_device=pc"
        class="lg:flex hidden h-20 justify-end items-center self-stretch gap-[70px] border-b border-[var(--primary)] shadow-[0_2px_0_rgba(0,0,0,0.1)]"
        target="_blank"
        rel="noopener noreferrer"
      >
        <p class="ms-3 opacity-50 text-[var(--backgroundGrey)] text-[16px] font-semibold leading-6">TikTok: kineto.by.zevedei</p>
        <div class="items-center justify-center flex self-end w-[70px] h-[70px] rounded-t-[12px] bg-[var(--primary)] shadow-[0_4px_0_rgba(0,0,0,0.15)]">
          <Image src={TiktokIcon} alt="Tiktok icon" />
        </div>
      </a>
      <a
        href="https://www.tiktok.com/@kineto.by.zevedei?is_from_webapp=1&sender_device=pc"
        class="items-center lg:hidden justify-center flex self-end w-[70px] h-[70px] rounded-[12px] bg-[var(--primary)] shadow-[0_4px_0_rgba(0,0,0,0.15)]"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Image src={TiktokIcon} alt="Tiktok icon" />
      </a>
      <a
        href="https://www.instagram.com/kineto.by.zevedei?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw=="
        class="hidden lg:flex h-20 justify-end items-center self-stretch gap-[70px] border-b border-[var(--primary)] shadow-[0_2px_0_rgba(0,0,0,0.1)]"
        target="_blank"
        rel="noopener noreferrer"
      >
        <p class="ms-3 opacity-50 text-[var(--backgroundGrey)] text-[16px] font-semibold leading-6">Insta: kineto.by.zevedei</p>
        <div class="items-center justify-center flex self-end w-[70px] h-[70px] rounded-t-[12px] bg-[var(--primary)] shadow-[0_4px_0_rgba(0,0,0,0.15)]">
          <Image src={InstaIcon} alt="Instagram icon" />
        </div>
      </a>
      <a
        href="https://www.instagram.com/kineto.by.zevedei?utm_source=ig_web_button_share_sheet&igsh=ZDNlZDc0MzIxNw=="
        class="lg:hidden items-center justify-center flex self-end w-[70px] h-[70px] rounded-[12px] bg-[var(--primary)] shadow-[0_4px_0_rgba(0,0,0,0.15)]"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Image src={InstaIcon} alt="Instagram icon" />
      </a>
    </div>
  </div>
</footer>

<!-- Inline styles removed in favor of Tailwind classes -->
