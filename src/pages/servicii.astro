---
import Contact from "../components/contact.astro";
import Services from "../components/services.astro";
import Layout from "../layouts/Layout.astro";
---

<script>
  window.addEventListener("load", () => {
    if (window.location.hash === "#contact") {
      // Prevent the default jump

      const target = document.getElementById("contact");
      if (target) {
        // Next animation frame to ensure layout is settled
        requestAnimationFrame(() => {
          target.scrollIntoView({ behavior: "smooth", block: "end" });
        });
      }
    }
  });
</script>

<Layout
  title="Servicii Masaj & Kinetoterapie la domiciliu în București | Kineto By Zevedei"
  description="Servicii mobile în București: masaj terapeutic, kinetoterapie, dry needling. Venim la tine acasă, în toate sectoarele."
>
  <Services />
  <div id="contact"><Contact /></div>
</Layout>
