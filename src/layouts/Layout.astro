---
import Header from "../components/header.astro";
import Tiktok from "../assets/icons/tiktok-icon.svg";
import Insta from "../assets/icons/insta-icon.svg";
import Image from "astro/components/Image.astro";
import "../styles/global.css";
import Footer from "../components/footer.astro";

// Per-page SEO props with sensible defaults
const {
  title =
    "Masaj Terapeutic, Kinetoterapie & Dry Needling în București | Kineto By Zevedei",
  description =
    "Licențiat UMF Carol Davila, ofer masaj terapeutic, dry needling, acupunctură și chiropractica în București. Tratamente personalizate pentru dureri, relaxare și recuperare fizică.",
} = Astro.props;

// Build canonical URL once in frontmatter (safer than JSX IIFE)
const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).toString()
  : Astro.url?.pathname ?? "/";
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="ro-RO" href={canonicalUrl} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="masaj terapeutic București, fizioterapie, kinetoterapie, dry needling, acupunctură, chiropractica, recuperare fizică, dureri musculare, terapie fizică, Zevedei Terapie"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta
      property="og:image"
      content="https://kinetobyzevedei.com/small-logo.jpg"
    />
    <meta property="og:image:alt" content="Kineto by Zevedei logo" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://kinetobyzevedei.com/small-logo.jpg" />
    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";
        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-ML9VRG4F");
    </script>

    <!-- End Google Tag Manager -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,100..700;1,100..700&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Space+Grotesk:wght@300..700&display=swap"
      rel="stylesheet"
    />
    
    <script type="application/ld+json" is:inline>
      {JSON.stringify({
        "@context": "https://schema.org",
        "@type": "MedicalBusiness",
        "@id": "https://kinetobyzevedei.com/#business",
        name: "Kineto by Zevedei",
        url: "https://kinetobyzevedei.com/",
        image: "https://kinetobyzevedei.com/small-logo.jpg",
        logo: "https://kinetobyzevedei.com/small-logo.jpg",
        description:
          "Masaj terapeutic, kinetoterapie și dry needling la domiciliu în București.",
        telephone: "+40725651009",
        areaServed: [
          "București",
          "Sector 1",
          "Sector 2",
          "Sector 3",
          "Sector 4",
          "Sector 5",
          "Sector 6"
        ],
        priceRange: "lei",
        medicalSpecialty: ["Physiotherapy", "Chiropractic", "Acupuncture"],
        hasOfferCatalog: {
          "@type": "OfferCatalog",
          name: "Servicii",
          itemListElement: [
            { "@type": "Offer", itemOffered: { "@type": "Service", name: "Masaj terapeutic la domiciliu" } },
            { "@type": "Offer", itemOffered: { "@type": "Service", name: "Kinetoterapie la domiciliu" } },
            { "@type": "Offer", itemOffered: { "@type": "Service", name: "Dry needling" } }
          ]
        },
        founder: { "@type": "Person", name: "Antonio Zevedei" },
        sameAs: [
          "https://www.instagram.com/kineto.by.zevedei/",
          "https://www.tiktok.com/@kineto.by.zevedei"
        ]
      })}
    </script>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-ML9VRG4F"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <div
      class="head-social hidden lg:flex justify-end self-stretch items-center"
    >
      <Image src={Tiktok} alt="Tiktok icon for social page" />
      <p>
        Tik Tok : <a
          target="_blank"
          rel="noopener noreferrer"
          class="social"
          href="https://www.tiktok.com/@kineto.by.zevedei">kineto.by.zevedei</a
        >
      </p>
      <Image src={Insta} alt="Instagram icon for social page" />
      <p>
        Insta : <a
          target="_blank"
          rel="noopener noreferrer"
          class="social"
          href="https://www.instagram.com/kineto.by.zevedei/"
          >kineto.by.zevedei</a
        >
      </p>
    </div>
    <Header />
    <slot />
    <Footer />
  </body>
</html>

<style>
  .social:hover {
    color: var(--secondary);
    text-decoration: underline;
  }
  html,
  body {
    scroll-behavior: smooth;
    overflow: auto;
    margin: 0;
    width: 100%;
    height: 100%;
    font-family: "Poppins", sans-serif !important;
  }
  html {
    box-sizing: border-box;
  }

  .head-social {
    background-color: #ebebeb;
    height: 64px;
    padding: 0 88px 0 88px;
    gap: 14px;
    color: var(--textBlack);
    text-align: center;
    font-size: 16px;
    font-weight: 700;
    line-height: 24px;
  }
  @media only screen and (max-width: 1024px) {
    body {
      padding-top: 30px;
    }
  }
</style>
